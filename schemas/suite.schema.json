{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.dev/schemas/suite-v1.json",
  "title": "Agent Harness Evaluation Suite",
  "type": "object",
  "required": ["name", "cases"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1, "default": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "policy": {"$ref": "policy.schema.json"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "turns": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "expected": {"type": "object"},
          "forbidden": {"type": "array", "items": {"type": "string"}},
          "tags": {"type": "array", "items": {"type": "string"}},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
